# ====================================================================
# Project-1S — Environment Configuration
# ====================================================================
# Place your environment variables here or in the root '.env' file.
# When deploying to Vercel, enter these keys in Vercel Project Settings -> Environment Variables.
#
# NOTE: The Kisan Mitra Agriculture Chatbot works 100% autonomously
# with its built-in ICAR/TNAU Expert Knowledge Engine out of the box!
# An external API key is OPTIONAL for extended generative capabilities.
# ====================================================================

# [OPTIONAL] Google Gemini API Key
# If provided, the chatbot connects to Gemini 1.5 Flash.
# If omitted or left empty, it seamlessly uses the built-in Expert Knowledge Engine.
# Free Tier available at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# [OPTIONAL] Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
